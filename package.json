{
  "name": "ps-usage-time",
  "version": "1.4.2",
  "description": "Photoshop Usage Time Tracker UXP Plugin",
  "main": "plugin/PS_UTT_V1.4.2_beta/bundle.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.tsx --bundle --outfile=plugin/PS_UTT_V1.4.2_beta/bundle.js --format=cjs --target=es2022 --external:uxp --external:photoshop",
    "bundle": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "photoshop",
    "uxp",
    "time-tracker"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  }
}
